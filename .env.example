# Shadow Mode configuration — copy to .env and fill in. Never commit .env.
#
# Environment variables take precedence over values in .env, so a deployment can
# override any of these without editing the file.

# --- Dashboard Orthanc (Phase 3+) ---------------------------------------------
# The authoritative DICOM store. Confirm WHICH Orthanc this is before using it:
# several instances typically run on the same host on neighbouring ports.
ORTHANC_URL=http://localhost:8043

# HTTP Basic auth. Orthanc's "Secure Area" realm.
ORTHANC_USERNAME=
ORTHANC_PASSWORD=

# Seconds. Raise for large instance downloads over a slow link.
ORTHANC_TIMEOUT_S=30

# Set false only for an internal host with a self-signed certificate.
ORTHANC_VERIFY_SSL=true
