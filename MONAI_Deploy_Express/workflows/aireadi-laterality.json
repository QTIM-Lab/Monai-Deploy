{
	"name": "aireadi-laterality",
	"version": "2.3.0",
	"dataRetentionDays": 1,
	"description": "AIREADI laterality: router keeps OP series, the MAP scores colour photos and writes SRs linked to their source images (none for other OP types: outputs optional), export C-STOREs them back to Orthanc",
	"informatics_gateway": {
		"ae_title": "MONAI-DEPLOY",
		"data_origins": [
			"ORTHANC"
		],
		"export_destinations": [
			"ORTHANC"
		]
	},
	"tasks": [
		{
			"id": "router",
			"description": "Only colour fundus photographs (Modality OP, ImageType contains COLOR/Color) go to the laterality model; a payload is one series (IG groups per series)",
			"type": "router",
			"task_destinations": [
				{
					"name": "laterality",
					"conditions": [
						"{{ context.dicom.series.any('0008','0060') }} == 'OP' AND {{ context.dicom.series.any('0008','0008') }} CONTAINS ['COLOR', 'Color']"
					]
				}
			]
		},
		{
			"id": "laterality",
			"description": "AIREADI laterality MAP: any DICOM tree in, one linked TID 1500 SR per scored image out (maps/aireadi_laterality)",
			"type": "docker",
			"args": {
				"container_image": "aireadi_laterality-x64-workstation-dgpu-linux-amd64:0.2.0",
				"server_url": "unix:///var/run/docker.sock",
				"entrypoint": "/bin/bash,-c",
				"command": "python3 -u /opt/holoscan/app",
				"task_timeout_minutes": "30",
				"temp_storage_container_path": "/var/lib/mde/",
				"env_HOLOSCAN_INPUT_PATH": "/var/holoscan/input/",
				"env_HOLOSCAN_OUTPUT_PATH": "/var/holoscan/output/"
			},
			"artifacts": {
				"input": [
					{
						"name": "env_HOLOSCAN_INPUT_PATH",
						"value": "{{ context.input.dicom }}"
					}
				],
				"output": [
					{
						"name": "env_HOLOSCAN_OUTPUT_PATH",
						"mandatory": false
					}
				]
			},
			"task_destinations": [
				{
					"name": "export-sr"
				}
			]
		},
		{
			"id": "export-sr",
			"description": "C-STORE the MAP's output folder (DICOM only) back to Orthanc",
			"type": "export",
			"export_destinations": [
				{
					"Name": "ORTHANC"
				}
			],
			"artifacts": {
				"input": [
					{
						"name": "export-dicom",
						"value": "{{ context.executions.laterality.artifacts.env_HOLOSCAN_OUTPUT_PATH }}",
						"mandatory": false
					}
				],
				"output": []
			}
		}
	]
}
